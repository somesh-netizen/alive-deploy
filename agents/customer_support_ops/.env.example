# Copy to .env (or configure in the console UI). Set at least ONE provider.
# Secrets are provided at runtime and are never baked into the image.

# --- OpenAI
OPENAI_API_KEY=
# --- Anthropic (Claude)
ANTHROPIC_API_KEY=
# --- Google Gemini
GOOGLE_API_KEY=
# --- Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
# --- OpenRouter
OPENROUTER_API_KEY=
# --- NVIDIA
NVIDIA_API_KEY=
# --- AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# --- Ollama (local models)
OLLAMA_HOST=http://host.docker.internal:11434

# --- pgvector (self-host vector store). Only used when a network selects the
# pgvector backend; harmless otherwise. In SaaS, managed Postgres+pgvector is
# provisioned per tenant instead (see P1-T15). The password is a secret; it is
# read from the environment and never baked into the image.
POSTGRES_DB=alive
POSTGRES_USER=alive
POSTGRES_PASSWORD=alive
